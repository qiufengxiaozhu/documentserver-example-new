<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.filez.demo.dao.OpenApiTaskMapper">

    <resultMap id="BaseResultMap" type="com.filez.demo.entity.OpenApiTaskEntity">
        <id column="id" property="id" />
        <result column="task_id" property="taskId" />
        <result column="api_name" property="apiName" />
        <result column="doc_id" property="docId" />
        <result column="doc_name" property="docName" />
        <result column="op_type" property="opType" />
        <result column="request_body" property="requestBody" />
        <result column="status" property="status" />
        <result column="content_id" property="contentId" />
        <result column="result_filename" property="resultFilename" />
        <result column="result_doc_id" property="resultDocId" />
        <result column="error_msg" property="errorMsg" />
        <result column="server_response" property="serverResponse" />
        <result column="user_id" property="userId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT * FROM openapi_task WHERE task_id = #{taskId} LIMIT 1
    </select>

    <select id="selectPageByUserId" resultMap="BaseResultMap">
        SELECT * FROM openapi_task
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM openapi_task WHERE user_id = #{userId}
    </select>

    <delete id="deleteByTaskId">
        DELETE FROM openapi_task WHERE task_id = #{taskId}
    </delete>

    <delete id="batchDeleteByTaskIds">
        DELETE FROM openapi_task WHERE task_id IN
        <foreach collection="taskIds" item="taskId" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>

</mapper>
